MONGO_DB_URL=mongodb://localhost:27018/aandi_performance
BASE_URL=http://localhost:8080
TARGET_ENVIRONMENT=local
REQUIRE_LOCAL_BASE_URL=true

FIXTURE_COURSES=1
FIXTURE_ASSIGNMENTS=1000
FIXTURE_CLEANUP_MAX_ASSIGNMENTS=1000
FIXTURE_ENROLLMENTS=100
FIXTURE_CLEANUP_MAX_ENROLLMENTS=100
FIXTURE_SUBMISSION_STATUSES=60
COURSE_SLUG=perf-k6
ASSIGNMENT_ID=10000000-0000-4000-8000-000000000001
PRIVATE_TESTCASE_MARKER=PERF_PRIVATE_MUST_NOT_LEAK_001
